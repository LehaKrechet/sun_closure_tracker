@startuml concept_model

package "Client Application" {
    class App {
        - unique_ptr<ARecogniser> recogniser
        - unique_ptr<ASendler> sendler
        + run() : int
    }

    interface ARecogniser {
        + {abstract} recognize(cv::Mat image)
        + {abstract} getCloudBoxes() : std::vector<cv::Rect>
        + {abstract} getSunBox() : cv::Rect
    }

    class FooRecognizer {
        - std::vector<TrackedCloud> tracks
        + recognize(cv::Mat image)
    }

    interface ASendler {
        + {abstract} send(string msg) : std::string
    }

    class FooSendler {
        + send(string msg) : std::string
    }
}

package "Remote Server (HTTP)" {
    class EngineStateMachine {
        - State state
        + process_event(start_command)
        + process_event(stop_command)
        + get_status_string() : std::string
    }

    enum State <<enum>> {
        STOPPED
        RUNNING
    }
}

' Связи реализации
ARecogniser <|-- FooRecognizer
ASendler <|-- FooSendler

' Связи владения
App o--> ARecogniser
App o--> ASendler

note bottom of EngineStateMachine
    Логика:
    STOPPED --> RUNNING : "start"
    RUNNING --> STOPPED : "stop"
end note

@enduml